{
  "manifest_version": 3,
  "name": "Afilados Connect",
  "version": "1.0.0",
  "description": "Automação e captura rápida de ofertas para afiliados Afilados",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Afilados Connect"
  },
  "permissions": ["storage", "activeTab", "scripting", "cookies", "alarms"],
  "host_permissions": [
    "http://localhost/*",
    "http://127.0.0.1/*",
    "*://*.mercadolivre.com.br/*",
    "*://*.amazon.com.br/*",
    "*://*.magazineluiza.com.br/*",
    "*://*.magazinevoce.com.br/*",
    "*://*.shopee.com.br/*"
  ],
  "background": {
    "service_worker": "background/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.mercadolivre.com.br/*",
        "*://*.amazon.com.br/*",
        "*://*.magazineluiza.com.br/*",
        "*://*.magazinevoce.com.br/*",
        "*://*.shopee.com.br/*"
      ],
      "js": ["content/content.js"],
      "css": ["content/content.css"]
    }
  ]
}
