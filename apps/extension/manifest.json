{
  "manifest_version": 3,
  "name": "Afilados Connect",
  "version": "1.1.0",
  "description": "Automação e captura rápida de ofertas para afiliados Afilados (Mercado Livre, Amazon, Magalu, Shopee, AliExpress e parceiros AWIN)",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Afilados Connect"
  },
  "permissions": ["storage", "activeTab", "scripting", "cookies", "alarms", "clipboardWrite"],
  "host_permissions": [
    "http://localhost/*",
    "http://127.0.0.1/*",
    "https://afiliado.dudurochatec.com.br/*",
    "https://api.awin.com/*",
    "*://*.awin1.com/*",
    "*://*/*"
  ],
  "background": {
    "service_worker": "background/background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://*/*"],
      "js": ["content/coupon-stores.js", "content/content.js"],
      "css": ["content/content.css"]
    }
  ]
}
