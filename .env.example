# Banco e fila
DATABASE_URL=postgresql://afilados:afilados@localhost:5434/afilados
REDIS_URL=redis://localhost:6379

# Segurança (gere com: openssl rand -hex 32)
APP_ENCRYPTION_KEY=
SESSION_SECRET=

# Seed
SEED_USER_EMAIL=admin@example.com
SEED_USER_PASSWORD=troque-esta-senha

# Marketplaces
SHOPEE_MOCK=1

# Deploy
DOMAIN=localhost

# API e worker
PORT=3001
WORKER_PORT=3002
WEB_ORIGIN=http://localhost:3000
WA_BROWSER_NAME=Afilados

# Produção (docker-compose.prod.yml)
POSTGRES_PASSWORD=troque-esta-senha
# DOMAIN (acima) deve ser o domínio público do painel, ex.: painel.seudominio.com.br
