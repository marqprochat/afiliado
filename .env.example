# Banco e fila
DATABASE_URL=postgresql://afilados:afilados@localhost:5434/afilados
REDIS_URL=redis://localhost:6379

# Segurança (gere com: openssl rand -hex 32)
APP_ENCRYPTION_KEY=
SESSION_SECRET=

# Seed
SEED_USER_EMAIL=admin@example.com
SEED_USER_PASSWORD=troque-esta-senha

# Marketplaces
SHOPEE_MOCK=1

# Deploy
DOMAIN=localhost

# API e worker
PORT=3001
WORKER_PORT=3002
WEB_ORIGIN=http://localhost:3000
WA_BROWSER_NAME=Afilados

# Portas expostas dos containers (host:container) — usadas pelo docker-compose.yml
POSTGRES_PORT=5434
REDIS_PORT=6379
API_PORT=3011
WORKER_HOST_PORT=3012
WEB_PORT=3010

# Produção (docker-compose.prod.yml)
POSTGRES_PASSWORD=troque-esta-senha
# DOMAIN (acima) deve ser o domínio público do painel, ex.: painel.seudominio.com.br

# Portas de host expostas por web/api em produção (docker-compose.prod.yml).
# Um proxy reverso externo (nginx do sistema, etc.) deve apontar DOMAIN para estas portas
# e cuidar do TLS — o compose de produção não expõe 80/443 nem inclui Caddy.
WEB_PROD_PORT=8010
API_PROD_PORT=8011
