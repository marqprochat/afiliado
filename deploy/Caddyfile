{$DOMAIN} {
  encode zstd gzip
  @api path /api/*
  handle @api {
    reverse_proxy api:3001
  }
  handle {
    reverse_proxy web:3000
  }
  header {
    Strict-Transport-Security "max-age=31536000"
    X-Content-Type-Options nosniff
    X-Frame-Options DENY
    Referrer-Policy strict-origin-when-cross-origin
  }
}
